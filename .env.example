# Copy these into Vercel -> Project -> Settings -> Environment Variables.
# Do NOT put real values in this file or commit them to git - this file only
# documents which names the code expects (see api/submit.js).

MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=sashakt_beneficiary_db

# Optional. Set to "true" only if your MySQL host requires SSL connections.
MYSQL_SSL=false

# Optional. Must match a location_name already in (or to be created in) the
# `locations` table.
DIVA_SALON_LOCATION=Diva Salon, Narol
